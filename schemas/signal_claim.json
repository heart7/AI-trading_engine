{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uchfe/schemas/signal_claim.json",
  "title": "Signal claim (\u00a74.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "kind",
    "class",
    "snapshot_hash",
    "policy_hash",
    "code_version",
    "created_at",
    "certified",
    "payload"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "kind": {
      "const": "signal_claim"
    },
    "class": {
      "const": "DERIVED"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "code_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 0
    },
    "certified": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "bar_close",
        "B",
        "M",
        "Z",
        "T",
        "abstain_reason",
        "data_age_s"
      ],
      "properties": {
        "instrument_id": {
          "type": "string"
        },
        "bar_close": {
          "type": "string",
          "format": "date-time"
        },
        "B": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "M": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "Z": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "T": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "abstain_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_inputs": {
          "type": "object"
        },
        "data_age_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
